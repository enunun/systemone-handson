# 判断エンジンの設定．`cp .env.example .env`で.envを作り，必要なら書き換える．
# .envは，pnpm startで実行するときに読み込まれる．Gitには入れない．

# 判断エンジンの種類：systemone(/v1/systemoneを話すサーバ)かfake(決まった答えを返す)
DECISION_ENGINE=systemone

# devcontainerのOllama
SYSTEMONE_BASE_URL=http://ollama:11434
SYSTEMONE_MODEL=tev1:0.8b
SYSTEMONE_API_KEY=ollama

# tev1:4bのように1件に10秒以上かかるモデルでは，問い合わせを待つ時間(ミリ秒)を延ばす．
# 省略すると，SDKの既定(10秒)を使う．
# SYSTEMONE_TIMEOUT_MS=60000

# 本家Jevに切り替えるときは，上の3行を次のように書き換える．
# SYSTEMONE_BASE_URL=https://api.typesafe.ai
# SYSTEMONE_MODEL=jev-latest
# SYSTEMONE_API_KEY=<TypeSafeのAPIキー>
